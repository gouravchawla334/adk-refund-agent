# Copy to refund_agent/.env (ADK loads .env from the agent folder):
#   cp .env.example refund_agent/.env

# Option A: Google AI Studio
GOOGLE_API_KEY=your-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Option B: Vertex AI (set GOOGLE_GENAI_USE_VERTEXAI=TRUE and uncomment)
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: override the SQLite location (defaults to ./local_refund_store.db)
# REFUND_DB_PATH=/tmp/local_refund_store.db
